<Window x:Class="FourTrac.App.StartupChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4TRAC 2027" Width="520" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/4trac2.ico">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/4tracSplash.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        <Border VerticalAlignment="Bottom" Background="#D9101820" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Previous session found" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Foreground="#DDE6EE" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="Use the inputs you had when you last closed the program, or start with the default example values?"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UsePreviousButton" Content="Use previous session" Width="160" Height="30"
                            IsDefault="True" Click="UsePrevious_Click"/>
                    <Button x:Name="StartFreshButton" Content="Start fresh" Width="110" Height="30" Margin="8,0,0,0"
                            Click="StartFresh_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
