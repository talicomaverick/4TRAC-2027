<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>_4TRAC.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\4TRAC.Core\4TRAC.Core.csproj" />
    <ProjectReference Include="..\..\src\4TRAC.Validation\4TRAC.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden reference data for V1 cross-validation (copied to <output>/golden/...). -->
    <None Include="..\..\data\golden\**\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="golden" />
  </ItemGroup>

</Project>
